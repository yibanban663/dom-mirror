{
  "name": "@lizhen-xxaq/dom-mirror",
  "version": "0.8.4",
  "description": "Remote browser DOM/CSS mirroring with a PNG frame fallback and optional font obfuscation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lizhen-xxaq/dom-mirror.git"
  },
  "main": "server.js",
  "files": [
    "server.js",
    "client/",
    "protected/",
    "assets/",
    "docs/PROTOCOL.md",
    "README.md",
    "LICENSE",
    "lib/",
    "tools/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "remote-browser-isolation",
    "rbi",
    "dom-mirror",
    "anti-scraping",
    "chromium",
    "cdp",
    "puppeteer"
  ],
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check lib/policy.js && node tools/check.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "puppeteer": "25.16.0",
    "sharp": "0.35.5",
    "ws": "8.22.0"
  }
}
